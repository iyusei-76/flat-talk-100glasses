# このファイルをコピーして .env を作成し、各値を設定してください
# cp .env.example .env

# Slack Tokens
# https://api.slack.com/apps でBot Token(xoxb-...)とApp-Level Token(xapp-...)を取得
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Database Settings
POSTGRES_DB=slackbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# GCP (Google OAuth / Calendar連携)
# https://console.cloud.google.com/apis/credentials で OAuthクライアントIDを作成
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# 1on1分析用DB（省略可: 未設定ならDB_*と同じ接続先を使う。物理的に別DBに分けたい場合のみ設定）
# ANALYTICS_DB_HOST=
# ANALYTICS_DB_NAME=
# ANALYTICS_DB_USER=
# ANALYTICS_DB_PASSWORD=
